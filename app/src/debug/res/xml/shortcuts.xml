<?xml version="1.0" encoding="utf-8"?>
<!-- Debug copy (package app.cardkeep.debug); keep in sync with src/main. Long-press the launcher icon. Each opens Add card (behind the app lock if it's up); Scan and Tap
     then start the camera / NFC reader once unlocked. Tap can't be hidden on phones without NFC
     (static shortcuts aren't conditional), so there it opens Add card with a short note. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_card"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent android:action="app.cardkeep.action.ADD_CARD"
            android:targetPackage="app.cardkeep.debug" android:targetClass="app.cardkeep.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="scan_card"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/shortcut_scan_short"
        android:shortcutLongLabel="@string/shortcut_scan_long">
        <intent android:action="app.cardkeep.action.SCAN_CARD"
            android:targetPackage="app.cardkeep.debug" android:targetClass="app.cardkeep.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="tap_card"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_tap"
        android:shortcutShortLabel="@string/shortcut_tap_short"
        android:shortcutLongLabel="@string/shortcut_tap_long">
        <intent android:action="app.cardkeep.action.TAP_CARD"
            android:targetPackage="app.cardkeep.debug" android:targetClass="app.cardkeep.MainActivity" />
    </shortcut>
</shortcuts>
